{
	"name": "mandaxing",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@12.11.2",
	"engines": {
		"node": ">=24.0.0",
		"pnpm": ">=12.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "biome check .",
		"format": "biome format --write .",
		"test:unit": "vitest",
		"test": "vitest run",
		"generate:fixtures": "node scripts/generate-audio-fixtures.mjs",
		"verify:audio": "node scripts/verify-audio-catalog.mjs",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@commitlint/cli": "21.2.3",
		"@commitlint/config-conventional": "21.2.3",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"fake-indexeddb": "6.2.5",
		"lint-staged": "17.6.0",
		"simple-git-hooks": "2.14.0",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vite": "8.3.4",
		"vitest": "5.0.4"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"simple-git-hooks": {
		"pre-commit": "corepack pnpm exec lint-staged",
		"commit-msg": "corepack pnpm exec commitlint --edit $1"
	},
	"lint-staged": {
		"*.{js,ts,json,css}": "biome check --write --no-errors-on-unmatched"
	},
	"dependencies": {
		"@fontsource-variable/inter": "5.3.0",
		"@fontsource-variable/noto-sans-sc": "5.3.1",
		"@fontsource-variable/space-grotesk": "5.3.0",
		"@fontsource/dm-mono": "5.3.0",
		"dexie": "4.4.6",
		"pitchfinder": "2.3.4",
		"ts-fsrs": "5.4.2"
	}
}
