{
	"name": "mandaxing",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@12.11.2",
	"engines": {
		"node": ">=24.0.0",
		"pnpm": ">=12.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "biome check .",
		"format": "biome format --write .",
		"test:unit": "vitest",
		"test": "vitest run"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"lint-staged": "^17.6.0",
		"simple-git-hooks": "^2.14.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"simple-git-hooks": {
		"pre-commit": "corepack pnpm exec lint-staged"
	},
	"lint-staged": {
		"*.{js,ts,json,css}": "biome check --write --no-errors-on-unmatched"
	}
}
